{
  "manifest_version": 3,
  "name": "Sidebar Remover – Hide Website Sidebars",
  "version": "1.1.1",
  "description": "Remove distracting sidebars from websites automatically for cleaner browsing and a distraction-free experience.",
  "permissions": ["storage", "activeTab", "tabs", "favicon", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sidebar Remover – Hide Website Sidebars",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["scrollbars.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
